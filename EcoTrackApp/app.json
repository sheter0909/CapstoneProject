{
  "expo": {
    "name": "EcoTrack",
    "slug": "ecotrack-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecotrackapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ecotrack.app"
    },
    "android": {
      "package": "com.ecotrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F7A37",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F7A37",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow EcoTrack to access your camera to scan household QR codes."
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
