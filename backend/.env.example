PORT=4000
DATABASE_URL="postgresql://neondb_owner:<password>@<your-neon-host>/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:<password>@<your-neon-host>/neondb?sslmode=require&channel_binding=require"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed CORS origins. Defaults to '*' (allow all), which is fine for this
# capstone project. Set a strict list (see below) only if you need to restrict access:
CORS_ORIGINS=*
