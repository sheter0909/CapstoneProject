# Port the API listens on.
PORT=4000
# Pooled Neon connection string used by the app at runtime (Prisma + pg adapter). Must include "-pooler" in the hostname.
DATABASE_URL="postgresql://neondb_owner:<password>@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (non-pooled) connection string used by prisma migrate deploy and Prisma CLI (see prisma.config.ts). Must NOT include "-pooler".
DIRECT_URL="postgresql://neondb_owner:<password>@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Hostname only (no scheme, credentials, or database name). Warns if local development targets production.
PROD_DB_HOST=ep-example.ap-southeast-1.aws.neon.tech
# Signs login JWTs and derives the passwordDisplay encryption key. Required in production; changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-secret
# How long login tokens stay valid (e.g. 1d, 12h).
JWT_EXPIRES_IN=1d
# Comma-separated allowed browser origins, or * for open CORS (dev only; never * with credentials in production).
CORS_ORIGINS=*
# Hours after submission during which a collector may edit their own collection entry.
EDIT_WINDOW_HOURS=24
# Set to production on Render; enables strict JWT_SECRET requirement.
NODE_ENV=development
